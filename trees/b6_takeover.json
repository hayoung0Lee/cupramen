{
  "tree": {
    "type": "sequence",
    "name": "B6: shelve all cups; a person can finish a placement by keyboard",
    "children": [
      {"type": "init_episode", "name": "Init ledger"},
      {"type": "repeat_until", "name": "Until all cups done", "until": "all_cups_done", "max_iterations": 20,
       "children": [
        {"type": "selector", "name": "One cup, or recover", "children": [
          {"type": "sequence", "name": "One cup", "children": [
            {"type": "select_next_task", "name": "Select cup and slot"},
            {"type": "selector", "name": "Have the cup", "children": [
              {"type": "is_holding", "name": "Already holding it?", "cup": "${current_cup}"},
              {"type": "sequence", "name": "Fetch it", "children": [
                {"type": "retry", "name": "Retry go to box", "num_failures": 2, "children": [
                  {"type": "go_to_box", "name": "Go to box", "cup": "${current_cup}"}
                ]},
                {"type": "retry", "name": "Retry pick", "num_failures": 3, "children": [
                  {"type": "pick_cup", "name": "Pick cup", "cup": "${current_cup}"}
                ]}
              ]}
            ]},
            {"type": "go_to_shelf", "name": "Carry to shelf", "cup": "${current_cup}", "slot": "${current_slot}"},

            {"type": "selector", "name": "Place on the slot", "children": [
              {"type": "sequence", "name": "Robot places", "children": [
                {"type": "check_place_ready", "name": "Can place accurately?", "cup": "${current_cup}"},
                {"type": "place_cup",         "name": "Place cup",        "cup": "${current_cup}", "slot": "${current_slot}", "stop_for_takeover": true},
                {"type": "verify_placed",     "name": "Verify placement", "cup": "${current_cup}", "slot": "${current_slot}"}
              ]},
              {"type": "sequence", "name": "Person places", "children": [
                {"type": "operator_available", "name": "Someone at the keyboard?"},
                {"type": "retry", "name": "Until the person gets it right", "num_failures": 3, "children": [
                  {"type": "sequence", "name": "Person places (attempt)", "children": [
                    {"type": "request_takeover", "name": "Hand over to the person"},
                    {"type": "human_control",    "name": "Person drives (keyboard)"},
                    {"type": "verify_placed",    "name": "Robot checks the placement", "cup": "${current_cup}", "slot": "${current_slot}"},
                    {"type": "back_away",        "name": "Back away from the shelf"}
                  ]}
                ]}
              ]},
              {"type": "sequence", "name": "Robot places anyway (nobody answered)", "children": [
                {"type": "place_cup",     "name": "Place cup anyway",        "cup": "${current_cup}", "slot": "${current_slot}"},
                {"type": "verify_placed", "name": "Verify placement anyway", "cup": "${current_cup}", "slot": "${current_slot}"}
              ]}
            ]},

            {"type": "mark_placed", "name": "Mark placed"}
          ]},
          {"type": "recover", "name": "Recover"}
        ]}
      ]}
    ]
  }
}
