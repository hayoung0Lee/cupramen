WorldInfo {
  info [
    "This simulation shows a TIAGo with Hey5 hand making hello with the sign 'Peace' with these fingers in an industrial environment. It can also be controlled using the arrows on the keyboard."
  ]
  title "Simulation of PAL Robotics' TIAGo robot with Hey5 hand"
}
